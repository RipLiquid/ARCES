if(NOT DEFINED PROGRAM OR NOT DEFINED ROOT)
    message(FATAL_ERROR "PROGRAM and ROOT are required")
endif()
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef suffix)
set(result_root "${ROOT}/run-${suffix}")
file(MAKE_DIRECTORY "${result_root}")

function(run_ok)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    if(NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "Expected success; got ${code}: ${err}\n${out}")
    endif()
endfunction()

function(run_error expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    string(FIND "${err}" "${expected}" position)
    if(NOT "${code}" STREQUAL "1" OR position EQUAL -1)
        message(FATAL_ERROR "Expected error '${expected}'; got ${code}: ${err}\n${out}")
    endif()
endfunction()

function(json_equals text field expected)
    string(JSON actual GET "${text}" "${field}")
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${field}: expected ${expected}, got ${actual}")
    endif()
endfunction()

run_ok(analyze "${ROOT}/full" 43.65 -79.38 --output "${result_root}/full")
file(READ "${result_root}/full/trend.json" full)
json_equals("${full}" status ok)
json_equals("${full}" complete_years 15)
json_equals("${full}" observed_months 180)
json_equals("${full}" absent_months 0)
string(JSON slope GET "${full}" slope_c_per_decade)
if(slope LESS 0.999999 OR slope GREATER 1.000001)
    message(FATAL_ERROR "Expected known synthetic slope 1 C/decade, got ${slope}")
endif()
file(STRINGS "${result_root}/full/monthly.csv" monthly)
list(LENGTH monthly count)
if(NOT count EQUAL 181)
    message(FATAL_ERROR "Expected 180 monthly data rows, got ${count} lines")
endif()

run_ok(analyze "${ROOT}/gaps" 43.65 -79.38 --output "${result_root}/gaps")
file(READ "${result_root}/gaps/trend.json" gaps)
json_equals("${gaps}" complete_years 12)
json_equals("${gaps}" absent_months 1)
json_equals("${gaps}" missing_value_months 2)
file(READ "${result_root}/gaps/gaps.csv" gap_csv)
foreach(expected "2005-04,no_observation" "2006-02,missing_value" "2007-03,missing_value")
    string(FIND "${gap_csv}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing coverage issue: ${expected}")
    endif()
endforeach()

run_ok(analyze "${ROOT}/packed" 43.65 -79.38 --output "${result_root}/packed")
file(READ "${result_root}/packed/trend.json" packed)
json_equals("${packed}" status insufficient_data)
file(READ "${result_root}/packed/monthly.csv" packed_csv)
string(FIND "${packed_csv}" ",280," position)
if(position EQUAL -1)
    message(FATAL_ERROR "Packed temperature was not decoded to 280 K")
endif()

run_ok(analyze "${ROOT}/all-missing" 43.65 -79.38 --output "${result_root}/missing")
file(READ "${result_root}/missing/trend.json" missing)
json_equals("${missing}" complete_years 0)
json_equals("${missing}" missing_value_months 12)
run_ok(analyze "${ROOT}/full" 43.65 -79.38 --start 2000-02 --end 2001-12 --output "${result_root}/window")
file(READ "${result_root}/window/trend.json" window)
json_equals("${window}" complete_years 1)
json_equals("${window}" observed_months 23)

run_error("Duplicate month" analyze "${ROOT}/duplicate" 43.65 -79.38 --output "${result_root}/duplicate")
run_error("grid location changes" analyze "${ROOT}/shifted" 43.65 -79.38 --output "${result_root}/shifted")
run_error("temperature units K" analyze "${ROOT}/wrong-units" 43.65 -79.38 --output "${result_root}/wrong")
run_error("Expected T2M dimensions" analyze "${ROOT}/wrong-shape" 43.65 -79.38 --output "${result_root}/shape")
run_ok(analyze "${ROOT}/valid-range" 43.65 -79.38 --output "${result_root}/range")
file(READ "${result_root}/range/gaps.csv" range_csv)
string(FIND "${range_csv}" "outside_valid_range" range_found)
if(range_found EQUAL -1)
    message(FATAL_ERROR "valid_range violation was not flagged")
endif()
run_error("Output directory already exists" analyze "${ROOT}/full" 43.65 -79.38 --output "${result_root}/full")
run_error("Start month" analyze "${ROOT}/full" 43.65 -79.38 --start 2010-01 --end 2000-01 --output "${result_root}/reversed")
run_error("No records remain" analyze "${ROOT}/full" 43.65 -79.38 --start 2020-01 --output "${result_root}/empty")
run_error("Minimum complete years" analyze "${ROOT}/full" 43.65 -79.38 --min-years 2 --output "${result_root}/minimum")
run_ok("${ROOT}/packed/packed.nc4" 43.65 -79.38 "${result_root}/single.csv")
run_error("Output file already exists" "${ROOT}/packed/packed.nc4" 43.65 -79.38 "${result_root}/single.csv")
run_error("Output file already exists" "${ROOT}/packed/packed.nc4" 43.65 -79.38 "${ROOT}/packed/packed.nc4")
message(STATUS "Multi-file CSV, packing, coverage, date filtering, trends, and overwrite checks passed.")
