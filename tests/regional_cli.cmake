string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef suffix)
set(out "${ROOT}/region-${suffix}")
function(ok)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
    if(NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "Expected success, got ${code}: ${stderr}\n${stdout}")
    endif()
endfunction()
function(bad expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
    string(FIND "${stderr}" "${expected}" found)
    if(NOT "${code}" STREQUAL "1" OR found EQUAL -1)
        message(FATAL_ERROR "Expected '${expected}', got ${code}: ${stderr}\n${stdout}")
    endif()
endfunction()
ok(region "${ROOT}/full" --south 43.5 --north 46 --west -80 --east -79.375 --output "${out}/bbox")
file(READ "${out}/bbox/regional.json" meta)
string(JSON selected GET "${meta}" selected_cells)
string(JSON fitted GET "${meta}" fitted_cells)
if(NOT selected EQUAL 4 OR NOT fitted EQUAL 4)
    message(FATAL_ERROR "Expected 4 selected and fitted cells")
endif()
ok(analyze "${ROOT}/full" 43.5 -79.375 --output "${out}/point")
file(READ "${out}/point/trend.json" point)
file(READ "${out}/bbox/cells.geojson" cells)
string(JSON point_slope GET "${point}" slope_c_per_decade)
string(JSON region_slope GET "${cells}" features 1 properties slope_c_per_decade)
if(NOT "${point_slope}" STREQUAL "${region_slope}")
    message(FATAL_ERROR "Regional and point slopes differ")
endif()
ok(region "${ROOT}/full" --boundary "${BOUNDARY}" --output "${out}/ontario")
if(NOT EXISTS "${out}/ontario/boundary.source.json")
    message(FATAL_ERROR "Boundary attribution not copied")
endif()
bad("already exists" region "${ROOT}/full" --boundary "${BOUNDARY}" --output "${out}/ontario")
bad("all four bounds" region "${ROOT}/full" --south 43 --output "${out}/partial")
bad("requires --boundary" region "${ROOT}/full" --feature Ontario --output "${out}/feature")
bad("requires a boundary" region "${ROOT}/full" --output "${out}/none")
bad("Repeated option" region "${ROOT}/full" --output a --output b)
bad("Unknown option" region "${ROOT}/full" --unknown x)
bad("Missing value" region "${ROOT}/full" --output)
bad("Invalid geographic bounds" region "${ROOT}/full" --south 46 --north 43 --west -80 --east -79 --output "${out}/reversed")
bad("Start month" region "${ROOT}/full" --boundary "${BOUNDARY}" --start 2010-01 --end 2000-01 --output "${out}/dates")
bad("No records remain" region "${ROOT}/full" --boundary "${BOUNDARY}" --start 2020-01 --output "${out}/empty")

ok(region "${ROOT}/gaps" --south 43.5 --north 46 --west -80 --east -79.375 --output "${out}/gaps")
file(READ "${out}/gaps/cells.geojson" gaps)
foreach(pair "absent_months;1" "missing_value_months;2" "complete_years;12")
    list(GET pair 0 field)
    list(GET pair 1 expected)
    string(JSON actual GET "${gaps}" features 1 properties "${field}")
    if(NOT actual EQUAL expected)
        message(FATAL_ERROR "Regional gap count ${field}: expected ${expected}, got ${actual}")
    endif()
endforeach()
ok(region "${ROOT}/full" --south 43.5 --north 46 --west -80 --east -79.375 --min-years 20 --output "${out}/insufficient")
file(READ "${out}/insufficient/cells.geojson" insufficient)
string(JSON kind TYPE "${insufficient}" features 0 properties slope_c_per_decade)
if(NOT kind STREQUAL "NULL")
    message(FATAL_ERROR "Insufficient trend must be JSON null")
endif()
bad("Duplicate month" region "${ROOT}/duplicate" --boundary "${BOUNDARY}" --output "${out}/duplicate")
bad("grid coordinates change" region "${ROOT}/shifted" --boundary "${BOUNDARY}" --output "${out}/shifted")
bad("temperature units K" region "${ROOT}/wrong-units" --boundary "${BOUNDARY}" --output "${out}/units")
bad("Expected T2M dimensions" region "${ROOT}/wrong-shape" --boundary "${BOUNDARY}" --output "${out}/shape")

message(STATUS "Regional CLI, Ontario selection, matching point trend, provenance, and invalid inputs passed.")

foreach(name regional-trend.svg report.html)
    if(NOT EXISTS "${out}/ontario/${name}")
        message(FATAL_ERROR "Missing map output ${name}")
    endif()
endforeach()
file(READ "${out}/bbox/regional-trend.svg" map)
string(REGEX MATCHALL "class=\"grid-cell\"" markers "${map}")
list(LENGTH markers marker_count)
if(NOT marker_count EQUAL 4)
    message(FATAL_ERROR "Map must render exactly one marker per selected cell")
endif()
file(READ "${out}/ontario/report.html" html)
foreach(link regional-trend.svg regional.csv annual.csv gaps.csv cells.geojson regional.json boundary.geojson boundary.source.json)
    string(FIND "${html}" "href=\"${link}\"" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing report link ${link}")
    endif()
endforeach()
